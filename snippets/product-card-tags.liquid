{%- doc -%}
  Renders product tags for the product card as pills at bottom-left of image.

  @param {object} product - The product object.
  
  @example
  {% render 'product-card-tags', product: product %}
{%- enddoc -%}

{% liquid
  if product == blank or product.tags == blank
    assign show_tags = false
  else
    assign show_tags = true
    # Filter out system tags (starting with _) and limit to 2 tags
    assign filtered_tags = product.tags | reject: 'contains', '_'
    assign display_tags = filtered_tags | slice: 0, 2
    if display_tags.size == 0
      assign show_tags = false
    endif
  endif
-%}

{% if show_tags %}
  <div class="product-card-tags">
    {% for tag in display_tags %}
      <div class="product-card-tags__tag">
        {{ tag | upcase }}
      </div>
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}
  .product-card-tags {
    position: absolute;
    bottom: var(--padding-sm, 12px);
    left: var(--padding-sm, 12px);
    z-index: var(--layer-flat, 1);
    display: flex;
    flex-direction: column;
    gap: 6px;
    pointer-events: none;
  }

  .product-card-tags__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    background-color: rgb(255 255 255);
    color: rgb(0 0 0);
    font-size: var(--font-size--xs, 0.6875rem);
    font-weight: 600;
    line-height: 1.3;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }

  @media screen and (min-width: 750px) {
    .product-card-tags {
      bottom: var(--padding-md, 16px);
      left: var(--padding-md, 16px);
      gap: 8px;
    }

    .product-card-tags__tag {
      padding: 8px 14px;
      font-size: var(--font-size--xs, 0.75rem);
      max-width: 160px;
      border-radius: 8px;
    }
  }

  /* Hide tags on zoom-out view to match existing badge behavior */
  [product-grid-view='zoom-out'] .product-card-tags {
    display: none;
  }

  /* Ensure tags are visible above image but below interactive overlays */
  .card-gallery .product-card-tags {
    z-index: calc(var(--layer-flat, 1) + 1);
  }
{% endstylesheet %}