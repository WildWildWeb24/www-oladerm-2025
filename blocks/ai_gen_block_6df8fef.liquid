{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-gallery-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0px;
  }

  .ai-video-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-gallery-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background: #000;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-gallery-video-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-gallery-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    color: #999;
    font-size: 14px;
  }

  @media (max-width: 749px) {
    .ai-video-gallery-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-video-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-video-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_slide_width }}%;
      scroll-snap-align: start;
      padding-bottom: {{ block.settings.mobile_aspect_ratio }}%;
    }
  }
{% endstyle %}

<product-video-gallery
  class="ai-video-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-gallery-container-{{ ai_gen_id }}">
    <div class="ai-video-gallery-grid-{{ ai_gen_id }}">

      {% for i in (1..3) %}
        {% assign key = 'video_' | append: i %}
        {% assign video = product.metafields.custom[key].value %}

        <div class="ai-video-gallery-item-{{ ai_gen_id }}">
          {% if video %}
            <video
              class="ai-video-gallery-video-{{ ai_gen_id }}"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              {% for source in video.sources %}
                {% if source.format == 'mp4' %}
                  <source src="{{ source.url }}" type="video/mp4">
                {% endif %}
              {% endfor %}
            </video>
          {% else %}
            <div class="ai-video-gallery-placeholder-{{ ai_gen_id }}">
              Video {{ i }}
            </div>
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</product-video-gallery>

<script>
  (function () {
    class ProductVideoGallery extends HTMLElement {
      connectedCallback() {
        this.videos = this.querySelectorAll('video');
        this.initObserver();
      }

      initObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.5 }
        );

        this.videos.forEach((video) => observer.observe(video));
      }
    }

    if (!customElements.get('product-video-gallery')) {
      customElements.define('product-video-gallery', ProductVideoGallery);
    }
  })();
</script>

{% schema %}
{
  "name": "Product video gallery",
  "settings": [
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "label": "Desktop aspect ratio (%)",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "label": "Mobile slide width (%)",
      "min": 70,
      "max": 100,
      "step": 5,
      "default": 85
    },
    {
      "type": "range",
      "id": "mobile_aspect_ratio",
      "label": "Mobile aspect ratio (%)",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Product video gallery"
    }
  ]
}
{% endschema %}
