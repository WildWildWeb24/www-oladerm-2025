{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-accordion-video-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-accordion-video-container-{{ ai_gen_id }} {
    /* max-width: 1200px; */
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.desktop_gap }}px;
    align-items: start;
  }

  .ai-accordion-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-accordion-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-accordion-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-accordion-item-{{ ai_gen_id }}:first-child {
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-accordion-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.item_padding }}px 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    color: {{ block.settings.question_color }};
    font-size: {{ block.settings.question_size }}px;
    font-weight: 600;
  }

  .ai-accordion-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-accordion-item-{{ ai_gen_id }}.active .ai-accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-accordion-content-inner-{{ ai_gen_id }} {
    padding: 0 0 {{ block.settings.item_padding }}px;
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
  }

  .ai-video-gallery-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-video-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-gallery-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background: #000;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-gallery-video-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-gallery-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    color: #999;
    font-size: 14px;
  }

  @media (max-width: 749px) {
    .ai-accordion-video-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-accordion-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-accordion-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
    }

    .ai-accordion-content-inner-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_size | times: 0.9 }}px;
    }

    .ai-video-gallery-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-video-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-video-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_slide_width }}%;
      scroll-snap-align: start;
      padding-bottom: {{ block.settings.mobile_aspect_ratio }}%;
    }
  }
{% endstyle %}

<accordion-video-section-{{ ai_gen_id }}
  class="ai-accordion-video-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-accordion-video-container-{{ ai_gen_id }}">
    <div class="ai-accordion-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-accordion-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      <div class="ai-accordion-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% assign question_key = 'question_' | append: i %}
          {% assign answer_key = 'answer_' | append: i %}
          {% assign question = block.settings[question_key] %}
          {% assign answer = block.settings[answer_key] %}

          {% if question != blank %}
            <div class="ai-accordion-item-{{ ai_gen_id }} {% if forloop.first and block.settings.first_open %}active{% endif %}" data-accordion-item>
              <button
                class="ai-accordion-button-{{ ai_gen_id }}"
                aria-expanded="{% if forloop.first and block.settings.first_open %}true{% else %}false{% endif %}"
              >
                <span>{{ question }}</span>
                <svg class="ai-accordion-icon-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 7.5L10 12.5L15 7.5"/>
                </svg>
              </button>
              <div class="ai-accordion-content-{{ ai_gen_id }}">
                <div class="ai-accordion-content-inner-{{ ai_gen_id }}">
                  {{ answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <product-video-gallery class="ai-video-gallery-{{ ai_gen_id }}">
      <div class="ai-video-gallery-grid-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% assign key = 'video_' | append: i %}

          {% if product.metafields.custom[key] %}
            {% assign video = product.metafields.custom[key].value %}

            <div class="ai-video-gallery-item-{{ ai_gen_id }}">
              <video
                class="ai-video-gallery-video-{{ ai_gen_id }}"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                {% for source in video.sources %}
                  {% if source.format == 'mp4' %}
                    <source src="{{ source.url }}" type="video/mp4">
                  {% endif %}
                {% endfor %}
              </video>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </product-video-gallery>
  </div>
</accordion-video-section-{{ ai_gen_id }}>

<script>
  (function () {
    class AccordionVideoSection{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.accordionItems = this.querySelectorAll('[data-accordion-item]');
        this.videos = this.querySelectorAll('video');
        this.initAccordion();
        this.initVideoObserver();
      }

      initAccordion() {
        this.accordionItems.forEach((item) => {
          const button = item.querySelector('.ai-accordion-button-{{ ai_gen_id }}');
          const content = item.querySelector('.ai-accordion-content-{{ ai_gen_id }}');
          const contentInner = content.querySelector('.ai-accordion-content-inner-{{ ai_gen_id }}');

          if (item.classList.contains('active')) {
            content.style.maxHeight = contentInner.scrollHeight + 'px';
          }

          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');

            this.accordionItems.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.classList.remove('active');
                const otherContent = otherItem.querySelector('.ai-accordion-content-{{ ai_gen_id }}');
                const otherButton = otherItem.querySelector('.ai-accordion-button-{{ ai_gen_id }}');
                otherContent.style.maxHeight = '0';
                otherButton.setAttribute('aria-expanded', 'false');
              }
            });

            if (isActive) {
              item.classList.remove('active');
              content.style.maxHeight = '0';
              button.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              content.style.maxHeight = contentInner.scrollHeight + 'px';
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }

      initVideoObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.5 }
        );

        this.videos.forEach((video) => observer.observe(video));
      }
    }

    class ProductVideoGallery extends HTMLElement {
      connectedCallback() {
        this.videos = this.querySelectorAll('video');
        this.initObserver();
      }

      initObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.5 }
        );

        this.videos.forEach((video) => observer.observe(video));
      }
    }

    if (!customElements.get('accordion-video-section-{{ ai_gen_id }}')) {
      customElements.define('accordion-video-section-{{ ai_gen_id }}', AccordionVideoSection{{ ai_gen_id }});
    }

    if (!customElements.get('product-video-gallery')) {
      customElements.define('product-video-gallery', ProductVideoGallery);
    }
  })();
</script>

