{% doc %}
  @prompt
    Create a responsive HTML and CSS layout with the following requirements:
    
    Desktop view:
    
    Display three columns in a single row.
    
    Each column should contain a video embedded using a video URL.
    
    Mobile view:
    
    Convert the three columns into a horizontal slider / carousel.
    
    Users should be able to swipe to view each video.
    
    Video behavior:
    
    Videos must autoplay, be muted, and loop continuously.
    
    Ensure videos play smoothly on mobile and desktop browsers.
    
    Additional requirements:
    
    Use pure HTML and CSS (JavaScript only if absolutely required for the slider).
    
    Layout should be fully responsive.
    
    Follow clean, modern UI practices and cross-browser compatibility.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-carousel-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-carousel-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-carousel-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.video_background }};
  }

  .ai-video-carousel-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-video-carousel-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-video-carousel-slider-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
      margin: 0 -20px;
    }

    .ai-video-carousel-slider-track-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: {{ block.settings.gap }}px;
      padding: 0 20px;
    }

    .ai-video-carousel-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-video-carousel-slider-item-{{ ai_gen_id }} {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }

    .ai-video-carousel-dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-video-carousel-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      opacity: 0.3;
      transition: opacity 0.3s ease;
      border: none;
      padding: 0;
      cursor: pointer;
    }

    .ai-video-carousel-dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-video-carousel-slider-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-carousel-container-{{ ai_gen_id }}">
    <div class="ai-video-carousel-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign video_url = block.settings[video_url_key]
        %}
        <div class="ai-video-carousel-item-{{ ai_gen_id }}">
          <div class="ai-video-carousel-video-wrapper-{{ ai_gen_id }}">
            {% if video_url != blank %}
              <video
                class="ai-video-carousel-video-{{ ai_gen_id }}"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src="{{ video_url }}" type="video/mp4">
              </video>
            {% else %}
              <div class="ai-video-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="ai-video-carousel-slider-{{ ai_gen_id }}">
      <div class="ai-video-carousel-slider-track-{{ ai_gen_id }}" data-slider-track>
        {% for i in (1..3) %}
          {% liquid
            assign video_url_key = 'video_url_' | append: i
            assign video_url = block.settings[video_url_key]
          %}
          <div class="ai-video-carousel-slider-item-{{ ai_gen_id }}">
            <div class="ai-video-carousel-item-{{ ai_gen_id }}">
              <div class="ai-video-carousel-video-wrapper-{{ ai_gen_id }}">
                {% if video_url != blank %}
                  <video
                    class="ai-video-carousel-video-{{ ai_gen_id }}"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  >
                    <source src="{{ video_url }}" type="video/mp4">
                  </video>
                {% else %}
                  <div class="ai-video-carousel-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="ai-video-carousel-dots-{{ ai_gen_id }}" data-dots>
        {% for i in (1..3) %}
          <button
            class="ai-video-carousel-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            data-dot="{{ i }}"
            aria-label="Go to slide {{ i }}"
          ></button>
        {% endfor %}
      </div>
    </div>
  </div>
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.sliderTrack = this.querySelector('[data-slider-track]');
        this.dots = this.querySelectorAll('[data-dot]');
        
        if (!this.sliderTrack) return;

        this.setupSlider();
      }

      setupSlider() {
        let isScrolling;
        
        this.sliderTrack.addEventListener('scroll', () => {
          clearTimeout(isScrolling);
          
          isScrolling = setTimeout(() => {
            this.updateActiveDot();
          }, 100);
        });

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.dataset.dot) - 1;
            const slideWidth = this.sliderTrack.querySelector('.ai-video-carousel-slider-item-{{ ai_gen_id }}').offsetWidth;
            const gap = {{ block.settings.gap }};
            const scrollPosition = slideIndex * (slideWidth + gap);
            
            this.sliderTrack.scrollTo({
              left: scrollPosition,
              behavior: 'smooth'
            });
          });
        });
      }

      updateActiveDot() {
        const scrollLeft = this.sliderTrack.scrollLeft;
        const slideWidth = this.sliderTrack.querySelector('.ai-video-carousel-slider-item-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.gap }};
        const currentIndex = Math.round(scrollLeft / (slideWidth + gap));

        this.dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "url",
      "id": "video_url_1",
      "label": "Video URL 1"
    },
    {
      "type": "url",
      "id": "video_url_2",
      "label": "Video URL 2"
    },
    {
      "type": "url",
      "id": "video_url_3",
      "label": "Video URL 3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between videos",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Video style"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "56.25",
          "label": "16:9"
        },
        {
          "value": "75",
          "label": "4:3"
        },
        {
          "value": "100",
          "label": "1:1"
        },
        {
          "value": "125",
          "label": "4:5"
        },
        {
          "value": "177.78",
          "label": "9:16"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "video_background",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Mobile carousel"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video carousel"
    }
  ]
}
{% endschema %}
