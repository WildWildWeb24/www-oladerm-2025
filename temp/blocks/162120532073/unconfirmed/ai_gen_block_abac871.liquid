{% doc %}
  @prompt
    Generate two column 
    left side add block accordian and rightside product video gallery
    
    with responsive
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-accordion-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.accordion_gap }}px;
  }

  .ai-accordion-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.accordion_border_color }};
    border-radius: {{ block.settings.accordion_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.accordion_bg_color }};
  }

  .ai-accordion-header-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.accordion_padding }}px;
    background-color: {{ block.settings.accordion_header_bg }};
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background-color 0.3s ease;
  }

  .ai-accordion-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.accordion_header_hover }};
  }

  .ai-accordion-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.accordion_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.accordion_text_color }};
    margin: 0;
  }

  .ai-accordion-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: {{ block.settings.accordion_text_color }};
  }

  .ai-accordion-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-accordion-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-accordion-body-{{ ai_gen_id }} {
    padding: {{ block.settings.accordion_padding }}px;
    color: {{ block.settings.accordion_body_text_color }};
    font-size: {{ block.settings.accordion_body_size }}px;
    line-height: 1.6;
  }

  .ai-video-gallery-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.video_gap }}px;
  }

  .ai-video-main-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-main-{{ ai_gen_id }} iframe,
  .ai-video-main-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-thumbnails-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.thumbnail_columns }}, 1fr);
    gap: {{ block.settings.thumbnail_gap }}px;
  }

  .ai-video-thumbnail-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .ai-video-thumbnail-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    border-color: {{ block.settings.thumbnail_hover_border }};
  }

  .ai-video-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.thumbnail_active_border }};
  }

  .ai-video-thumbnail-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-play-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .ai-video-play-icon-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: #000;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-two-column-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-video-thumbnails-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-accordion-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.accordion_title_size | times: 0.9 }}px;
    }

    .ai-accordion-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.accordion_body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<two-column-accordion-video-{{ ai_gen_id }} class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-accordion-column-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign accordion_enabled_key = 'accordion_' | append: i | append: '_enabled'
          assign accordion_title_key = 'accordion_' | append: i | append: '_title'
          assign accordion_content_key = 'accordion_' | append: i | append: '_content'
          
          assign accordion_enabled = block.settings[accordion_enabled_key]
          assign accordion_title = block.settings[accordion_title_key]
          assign accordion_content = block.settings[accordion_content_key]
        %}

        {% if accordion_enabled %}
          <div class="ai-accordion-item-{{ ai_gen_id }}">
            <button
              class="ai-accordion-header-{{ ai_gen_id }}"
              aria-expanded="false"
              data-accordion-index="{{ i }}"
            >
              <h3 class="ai-accordion-title-{{ ai_gen_id }}">{{ accordion_title }}</h3>
              <svg class="ai-accordion-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="ai-accordion-content-{{ ai_gen_id }}" data-accordion-content="{{ i }}">
              <div class="ai-accordion-body-{{ ai_gen_id }}">
                {{ accordion_content }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-video-gallery-column-{{ ai_gen_id }}">
      <div class="ai-video-main-{{ ai_gen_id }}" data-main-video>
        {% if block.settings.video_1_url != blank %}
          <iframe
            src="{{ block.settings.video_1_url }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {% else %}
          <div class="ai-video-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
        {% endif %}
      </div>

      <div class="ai-video-thumbnails-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign video_url_key = 'video_' | append: i | append: '_url'
            assign video_thumbnail_key = 'video_' | append: i | append: '_thumbnail'
            
            assign video_url = block.settings[video_url_key]
            assign video_thumbnail = block.settings[video_thumbnail_key]
          %}

          {% if video_url != blank %}
            <div
              class="ai-video-thumbnail-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-video-url="{{ video_url }}"
              data-video-index="{{ i }}"
            >
              {% if video_thumbnail %}
                <img src="{{ video_thumbnail | image_url: width: 400 }}" alt="Video {{ i }}" loading="lazy">
              {% else %}
                <div class="ai-video-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </div>
              {% endif %}
              <div class="ai-video-play-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>
                </svg>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</two-column-accordion-video-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnAccordionVideo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccordion();
        this.setupVideoGallery();
      }

      setupAccordion() {
        const headers = this.querySelectorAll('.ai-accordion-header-{{ ai_gen_id }}');
        
        headers.forEach((header) => {
          header.addEventListener('click', () => {
            const index = header.getAttribute('data-accordion-index');
            const content = this.querySelector(`[data-accordion-content="${index}"]`);
            const isExpanded = header.getAttribute('aria-expanded') === 'true';

            headers.forEach((h) => {
              const i = h.getAttribute('data-accordion-index');
              const c = this.querySelector(`[data-accordion-content="${i}"]`);
              h.setAttribute('aria-expanded', 'false');
              c.classList.remove('active');
            });

            if (!isExpanded) {
              header.setAttribute('aria-expanded', 'true');
              content.classList.add('active');
            }
          });
        });
      }

      setupVideoGallery() {
        const mainVideo = this.querySelector('[data-main-video]');
        const thumbnails = this.querySelectorAll('.ai-video-thumbnail-{{ ai_gen_id }}');

        thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            const videoUrl = thumbnail.getAttribute('data-video-url');

            thumbnails.forEach((t) => t.classList.remove('active'));
            thumbnail.classList.add('active');

            mainVideo.innerHTML = `
              <iframe
                src="${videoUrl}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            `;
          });
        });
      }
    }

    customElements.define('two-column-accordion-video-{{ ai_gen_id }}', TwoColumnAccordionVideo{{ ai_gen_id }});
  })();
</script>

