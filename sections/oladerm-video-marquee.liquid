{% liquid
  assign section_id = 'oladerm-video-marquee-' | append: section.id
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
%}

<section id="{{ section_id }}" class="oladerm-video-marquee-section">
  <div class="oladerm-video-marquee__inner">
    {% if section.settings.heading != blank %}
      <div class="oladerm-video-marquee__header">
        <h2 class="oladerm-video-marquee__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if has_blocks %}
      <div
        class="oladerm-video-marquee"
        data-speed="{{ section.settings.speed }}"
        data-direction="{{ section.settings.direction }}"
        data-pause-hover="{{ section.settings.pause_on_hover }}"
      >
        <div class="oladerm-video-marquee__viewport">
          <div class="oladerm-video-marquee__track">
            {% for repeat in (1..2) %}
              <div class="oladerm-video-marquee__group" aria-hidden="{% if repeat == 2 %}true{% else %}false{% endif %}">
                {% for block in section.blocks %}
                  {% assign video = block.settings.video %}
                  {% assign video_url = block.settings.video_url %}
                  {% assign poster = block.settings.poster %}

                  <div class="oladerm-video-marquee__item" {{ block.shopify_attributes }}>
                    <div class="oladerm-video-marquee__card oladerm-video-marquee__card--{{ section.settings.card_ratio }}">
                      {% if video != blank %}
                        {{
                          video
                          | video_tag:
                            image_size: '900x',
                            autoplay: true,
                            loop: true,
                            muted: true,
                            controls: false,
                            playsinline: true,
                            preload: 'metadata',
                            class: 'oladerm-video-marquee__video'
                        }}
                      {% elsif video_url != blank %}
                        <video
                          class="oladerm-video-marquee__video"
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          {% if poster != blank %}
                            poster="{{ poster | image_url: width: 900 }}"
                          {% endif %}
                        >
                          <source src="{{ video_url }}" type="video/mp4">
                        </video>
                      {% else %}
                        <div class="oladerm-video-marquee__placeholder">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="oladerm-video-marquee__empty">
        Add video blocks to start the carousel.
      </div>
    {% endif %}
  </div>

  <style>

    #{{ section_id }} {
  width: 100vw;
  margin-left: calc(50% - 50vw);
}

    #{{ section_id }} {
      background: {{ section.settings.bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      overflow: hidden;
    }

    #{{ section_id }} .oladerm-video-marquee__header {
      margin-bottom: 18px;
    }

    #{{ section_id }} .oladerm-video-marquee__heading {
      margin: 0;
      font-size: clamp(22px, 3vw, 36px);
      line-height: 1.1;
    }

    #{{ section_id }} .oladerm-video-marquee {
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    #{{ section_id }} .oladerm-video-marquee__viewport {
      overflow: hidden;
      width: 100%;
    }

    #{{ section_id }} .oladerm-video-marquee__track {
      display: flex;
      width: max-content;
      gap: {{ section.settings.gap }}px;
      will-change: transform;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-name: oladerm-marquee-left-{{ section.id }};
      animation-duration: calc(60s / {{ section.settings.speed }});
    }

    #{{ section_id }} .oladerm-video-marquee__group {
      display: flex;
      flex-shrink: 0;
      gap: {{ section.settings.gap }}px;
    }

    #{{ section_id }} .oladerm-video-marquee__item {
      flex: 0 0 auto;
      width: {{ section.settings.card_width_desktop }}px;
      max-width: calc(100vw - 40px);
    }

    #{{ section_id }} .oladerm-video-marquee__card {
      position: relative;
      overflow: hidden;
      border-radius: {{ section.settings.radius }}px;
      background: {{ section.settings.card_bg }};
    }

    #{{ section_id }} .oladerm-video-marquee__card--portrait {
      aspect-ratio: 3 / 5;
    }

    #{{ section_id }} .oladerm-video-marquee__card--square {
      aspect-ratio: 1 / 1;
    }

    #{{ section_id }} .oladerm-video-marquee__card--landscape {
      aspect-ratio: 16 / 9;
    }

    #{{ section_id }} .oladerm-video-marquee__video,
    #{{ section_id }} .oladerm-video-marquee__card video,
    #{{ section_id }} .oladerm-video-marquee__placeholder,
    #{{ section_id }} .oladerm-video-marquee__placeholder svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #{{ section_id }} .oladerm-video-marquee__empty {
      padding: 28px;
      border-radius: {{ section.settings.radius }}px;
      background: rgba(0,0,0,0.04);
    }

    #{{ section_id }} .oladerm-video-marquee[data-pause-hover="true"]:hover .oladerm-video-marquee__track {
      animation-play-state: paused;
    }

    {% if section.settings.direction == 'right_to_left' %}
      @keyframes oladerm-marquee-left-{{ section.id }} {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(calc(-50% - ({{ section.settings.gap }}px / 2)), 0, 0); }
      }
    {% else %}
      #{{ section_id }} .oladerm-video-marquee__track {
        animation-name: oladerm-marquee-right-{{ section.id }};
      }

      @keyframes oladerm-marquee-right-{{ section.id }} {
        0% { transform: translate3d(calc(-50% - ({{ section.settings.gap }}px / 2)), 0, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #{{ section_id }} .oladerm-video-marquee__item {
        width: {{ section.settings.card_width_mobile }}px;
      }

      #{{ section_id }} .oladerm-video-marquee__track,
      #{{ section_id }} .oladerm-video-marquee__group {
        gap: {{ section.settings.gap_mobile }}px;
      }

      {% if section.settings.direction == 'right_to_left' %}
        @keyframes oladerm-marquee-left-{{ section.id }} {
          0% { transform: translate3d(0, 0, 0); }
          100% { transform: translate3d(calc(-50% - ({{ section.settings.gap_mobile }}px / 2)), 0, 0); }
        }
      {% else %}
        @keyframes oladerm-marquee-right-{{ section.id }} {
          0% { transform: translate3d(calc(-50% - ({{ section.settings.gap_mobile }}px / 2)), 0, 0); }
          100% { transform: translate3d(0, 0, 0); }
        }
      {% endif %}
    }
  </style>

  <script>
    (() => {
      const section = document.getElementById('{{ section_id }}');
      if (!section) return;

      const marquee = section.querySelector('.oladerm-video-marquee');
      if (!marquee) return;

      const track = marquee.querySelector('.oladerm-video-marquee__track');
      if (!track) return;

      const setDuration = () => {
        const speed = parseFloat(marquee.dataset.speed || '1');
        const group = marquee.querySelector('.oladerm-video-marquee__group');
        if (!group) return;

        const groupWidth = group.offsetWidth;
        if (!groupWidth) return;

        const pxPerSecond = 40 * speed;
        const duration = Math.max(groupWidth / pxPerSecond, 12);

        track.style.animationDuration = duration + 's';
      };

      const playAllVideos = () => {
        const videos = section.querySelectorAll('video');
        videos.forEach((video) => {
          video.muted = true;
          video.playsInline = true;

          const promise = video.play();
          if (promise && typeof promise.catch === 'function') {
            promise.catch(() => {});
          }
        });
      };

      window.addEventListener('load', () => {
        setDuration();
        playAllVideos();
      });

      window.addEventListener('resize', setDuration);

      document.addEventListener('shopify:section:load', setDuration);
      document.addEventListener('shopify:section:reorder', setDuration);
      document.addEventListener('shopify:block:select', setDuration);
      document.addEventListener('shopify:block:deselect', setDuration);
    })();
  </script>
</section>

{% schema %}
{
  "name": "Oladerm video marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real results, real routines"
    },
    {
      "type": "checkbox",
      "id": "page_width",
      "label": "Use page width container",
      "default": false
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "right_to_left",
      "options": [
        {
          "value": "right_to_left",
          "label": "Right to left"
        },
        {
          "value": "left_to_right",
          "label": "Left to right"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": false
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Video ratio",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card width desktop",
      "min": 180,
      "max": 420,
      "step": 10,
      "default": 280
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width mobile",
      "min": 140,
      "max": 280,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F3EEE6"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify hosted video"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "External MP4 URL",
          "info": "Use only if Shopify hosted video is not added"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Used for external MP4 only"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oladerm video marquee",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}