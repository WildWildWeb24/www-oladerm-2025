<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} home-concern color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% if section.settings.heading != blank %}
    <div class="home-concern__heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="home-concern__grid">
    {% for block in section.blocks %}
      <div class="home-concern__tile" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <div class="home-concern__media">
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
        <div class="home-concern__content">
          {% if block.settings.label != blank %}
            <p class="home-concern__label">{{ block.settings.label }}</p>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="home-concern__description">{{ block.settings.description }}</p>
          {% endif %}
          {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
            <a
              href="{{ block.settings.cta_link }}"
              class="home-concern__cta"
              {% if block.settings.cta_new_tab %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              {{ block.settings.cta_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .home-concern {
    --home-concern-gap: clamp(12px, 2vw, 20px);
  }

  .home-concern__heading {
    margin-bottom: clamp(12px, 2vw, 20px);
  }

  .home-concern__heading h2 {
    margin: 0;
    font-family: "Instrument Serif", sans-serif !important;
  }

  .home-concern__grid {
    display: grid;
    gap: var(--home-concern-gap);
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .home-concern__tile {
    background: rgb(var(--color-background-rgb));
    border-radius: var(--radius-md);
    overflow: hidden;
    display: grid;
    gap: 8px;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.06);
  }

  .home-concern__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .home-concern__content {
    padding: 12px;
    display: grid;
    gap: 6px;
  }

  .home-concern__label {
    margin: 0;
    font-weight: 600;
  }

  .home-concern__description {
    margin: 0;
    font-size: 0.9rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .home-concern__cta {
    justify-self: start;
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--color-accent-rgb, var(--color-foreground-rgb)));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by concern",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by concern"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "Add to cart"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "cta_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by concern",
      "category": "Custom",
      "blocks": [
        { "type": "concern", "settings": { "label": "Dry/Dehydrated", "description": "Hydrate and balance" } },
        { "type": "concern", "settings": { "label": "Uneven Texture", "description": "Smooth and refine" } },
        { "type": "concern", "settings": { "label": "Dull/Tired Skin", "description": "Revive radiance" } },
        { "type": "concern", "settings": { "label": "Blemishes", "description": "Clarify gently" } },
        { "type": "concern", "settings": { "label": "Daily UV Exposure", "description": "Protect and nourish" } }
      ]
    }
  ]
}
{% endschema %}
