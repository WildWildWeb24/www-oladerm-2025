{% comment %}
  OLADERM – Product Hero Section (Gallery + Product Info + Benefits + CTAs)

  Features:
  1) "Fit into container" option (Contained / Full width)
  2) Pulls all data from product (title, price, description, media)
  3) Optional: choose product in section settings (for non-product pages)

  Optional product metafields (namespace: custom):
  - custom.hero_badge_text  (single line text)  e.g. "Gentle Daily Cleanser"
  - custom.hero_pill_1      (single line text)  e.g. "Restores skin"
  - custom.hero_pill_2      (single line text)  e.g. "Vitamin C"

  Benefits:
  - Use section blocks (recommended). Add 3 blocks.
{% endcomment %}

{%- liquid
  assign picked_product = section.settings.product
  assign p = product
  if picked_product != blank
    assign p = picked_product
  endif

  if p == blank
    assign p = nil
  endif

  assign wrapper_class = ''
  case section.settings.container
    when 'contained'
      assign wrapper_class = 'oladerm__container'
    when 'full'
      assign wrapper_class = 'oladerm__container oladerm__container--full'
  endcase

  assign featured_media = p.featured_media
  if section.settings.default_media_position == 'first' and p.media.size > 0
    assign featured_media = p.media.first
  endif

  assign badge_text = section.settings.badge_text
  if badge_text == blank and p != nil
    assign badge_text = p.metafields.custom.hero_badge_text.value
  endif

  assign pill_1 = section.settings.pill_1
  if pill_1 == blank and p != nil
    assign pill_1 = p.metafields.custom.hero_pill_1.value
  endif

  assign pill_2 = section.settings.pill_2
  if pill_2 == blank and p != nil
    assign pill_2 = p.metafields.custom.hero_pill_2.value
  endif
-%}

<section class="oladerm-hero" data-section-id="{{ section.id }}">
  <div class="{{ wrapper_class }}">
    {% if p == nil %}
      <div class="oladerm__empty">
        <p><strong>No product found.</strong> Add this section on a product page, or select a product in the section settings.</p>
      </div>
    {% else %}

      <div class="oladerm__grid">

        <!-- LEFT: Gallery -->
        <div class="oladerm__gallery">
          <div class="oladerm__thumbs" role="list">
            {%- for m in p.media -%}
              {%- if m.media_type == 'image' -%}
                <button
                  class="oladerm__thumb{% if featured_media and m.id == featured_media.id %} is-active{% endif %}"
                  type="button"
                  aria-label="View image {{ forloop.index }}"
                  data-target-src="{{ m | image_url: width: 1600 }}"
                >
                  <img
                    src="{{ m | image_url: width: 180 }}"
                    alt="{{ m.alt | escape }}"
                    loading="lazy"
                    width="90"
                    height="90"
                  >
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="oladerm__main">
            <div class="oladerm__main-inner">
              {% if featured_media and featured_media.media_type == 'image' %}
                <img
                  class="oladerm__main-img"
                  src="{{ featured_media | image_url: width: 1600 }}"
                  alt="{{ featured_media.alt | escape }}"
                  loading="lazy"
                  width="1200"
                  height="1200"
                >
              {% endif %}

              <div class="oladerm__pills">
                {% if pill_1 != blank %}
                  <span class="oladerm__pill">{{ pill_1 }}</span>
                {% endif %}
                {% if pill_2 != blank %}
                  <span class="oladerm__pill">{{ pill_2 }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Content -->
        <div class="oladerm__content">
          {% if badge_text != blank %}
            <div class="oladerm__badge">{{ badge_text }}</div>
          {% endif %}

          <div class="oladerm__title-row">
            <h2 class="oladerm__title">{{ p.title }}</h2>

            <div class="oladerm__price">
              <div class="oladerm__price-amount">
                {{ p.selected_or_first_available_variant.price | money }}
              </div>

              <div class="oladerm__price-sub">
                {{ section.settings.tax_note }}
              </div>
            </div>
          </div>

          <div class="oladerm__divider"></div>

          {% if p.description != blank %}
            <div class="oladerm__desc rte">
              {{ p.description }}
            </div>
          {% endif %}

          <!-- Benefits (matches your 2nd screenshot) -->
          <div class="oladerm__benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' -%}
                <div class="oladerm__benefit" {{ block.shopify_attributes }}>
                  <div class="oladerm__benefit-icon">
                    {%- if block.settings.icon != blank -%}
                      <img
                        src="{{ block.settings.icon | image_url: width: 200 }}"
                        alt="{{ block.settings.title | escape }}"
                        loading="lazy"
                        width="80"
                        height="80"
                      >
                    {%- endif -%}
                  </div>

                  <div class="oladerm__benefit-title">
                    {{ block.settings.title }}
                  </div>

                  <div class="oladerm__benefit-sub">
                    {{ block.settings.text }}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- CTAs -->
          <div class="oladerm__ctas">
            {% if section.settings.primary_cta_label != blank %}
              <a class="oladerm__btn oladerm__btn--primary"
                href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}">
                {{ section.settings.primary_cta_label }}
              </a>
            {% endif %}

            <form method="post" action="{{ routes.cart_add_url }}" class="oladerm__add-form">
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                class="oladerm__btn oladerm__btn--secondary"
                {% unless p.selected_or_first_available_variant.available %}disabled{% endunless %}
              >
                {{ section.settings.add_to_cart_label }}
              </button>
            </form>
          </div>

        </div>
      </div>

    {% endif %}
  </div>

  <style>
    .oladerm-hero { padding: 28px 0; }

    .oladerm__container { max-width: 1200px; margin: 0 auto; padding: 0 18px; }
    .oladerm__container--full { max-width: none; padding: 0 24px; }

    .oladerm__grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      align-items: start;
    }

    /* Gallery */
    .oladerm__gallery {
      display: grid;
      grid-template-columns: 92px 1fr;
      gap: 16px;
      align-items: start;
    }

    .oladerm__thumbs { display: grid; gap: 12px; align-content: start; }
    .oladerm__thumb {
      border: 0;
      background: transparent;
      padding: 0;
      cursor: pointer;
      border-radius: 14px;
      overflow: hidden;
      outline: 1px solid rgba(0,0,0,0.08);
      transition: outline-color .15s ease, transform .15s ease;
    }
    .oladerm__thumb:hover { transform: translateY(-1px); }
    .oladerm__thumb.is-active { outline-color: rgba(0,0,0,0.28); }
    .oladerm__thumb img { display:block; width:100%; height:auto; aspect-ratio: 1 / 1; object-fit: cover; }

    .oladerm__main {
      border-radius: 28px;
      overflow: hidden;
      background: #0b1030;
      position: relative;
      min-height: 520px;
    }
    .oladerm__main-inner { position: relative; height: 100%; }
    .oladerm__main-img {
      display:block;
      width:100%;
      height: 100%;
      min-height: 520px;
      object-fit: cover;
    }

    .oladerm__pills {
      position: absolute;
      left: 18px;
      bottom: 18px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .oladerm__pill {
      background: #fff;
      color: #111;
      border-radius: 14px;
      padding: 10px 14px;
      font-size: 14px;
      line-height: 1;
      box-shadow: 0 10px 25px rgba(0,0,0,0.12);
      font-weight: 600;
    }

    /* Content */
    .oladerm__content { padding-top: 6px; }

    .oladerm__badge {
      display:inline-block;
      border: 1px solid rgba(162, 110, 70, 0.65);
      color: #7a4d2e;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 13px;
      margin-bottom: 12px;
      background: rgba(162,110,70,0.06);
    }

    .oladerm__title-row {
      display:flex;
      justify-content: space-between;
      gap: 24px;
      align-items: flex-start;
    }

    .oladerm__title {
      margin: 0;
      font-size: 42px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      max-width: 520px;
    }

    .oladerm__price { text-align: right; white-space: nowrap; }
    .oladerm__price-amount { font-size: 22px; font-weight: 700; }
    .oladerm__price-sub { font-size: 12px; opacity: 0.6; margin-top: 2px; }

    .oladerm__divider {
      height: 1px;
      background: rgba(0,0,0,0.10);
      margin: 18px 0 18px;
    }

    .oladerm__desc {
      font-size: 16px;
      line-height: 1.6;
      opacity: 0.9;
      max-width: 650px;
      margin-bottom: 18px;
    }

    /* ✅ BENEFITS: matches your 2nd image */
    .oladerm__benefits {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
      align-items: start;
      margin: 28px 0 28px;
    }

    .oladerm__benefit {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .oladerm__benefit-icon { margin-bottom: 16px; }
    .oladerm__benefit-icon img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .oladerm__benefit-title {
      font-weight: 800;
      font-size: 30px;
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .oladerm__benefit-sub {
      font-size: 18px;
      line-height: 1.4;
      opacity: 0.75;
      max-width: 280px;
    }

    /* CTAs */
    .oladerm__ctas { display: grid; gap: 14px; }
    .oladerm__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      border-radius: 14px;
      padding: 14px 16px;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.01em;
      border: 1px solid transparent;
      transition: transform .15s ease, opacity .15s ease;
    }
    .oladerm__btn:hover { transform: translateY(-1px); }
    .oladerm__btn--primary { background: #a26e46; color: #fff; }
    .oladerm__btn--secondary { background: transparent; color: #3a2a1e; border-color: rgba(162,110,70,0.45); }
    .oladerm__btn[disabled] { opacity: 0.5; cursor: not-allowed; }

    .oladerm__add-form { margin: 0; }

    /* Responsive */
    @media (max-width: 990px) {
      .oladerm__grid { grid-template-columns: 1fr; gap: 22px; }
      .oladerm__gallery { grid-template-columns: 1fr; }

      .oladerm__thumbs {
        order: 2;
        grid-auto-flow: column;
        grid-auto-columns: 84px;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 8px;
      }

      .oladerm__main { order: 1; min-height: 420px; }
      .oladerm__main-img { min-height: 420px; }

      .oladerm__title { font-size: 34px; }
      .oladerm__price { text-align: left; }
      .oladerm__title-row { flex-direction: column; gap: 10px; }
    }

    @media (max-width: 768px) {
      .oladerm__benefits {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .oladerm__benefit-title { font-size: 28px; }
      .oladerm__benefit-sub { font-size: 17px; }
    }

    .oladerm__empty {
      border: 1px dashed rgba(0,0,0,0.25);
      border-radius: 16px;
      padding: 18px;
      background: rgba(0,0,0,0.02);
    }
  </style>

  <script>
    (function() {
      var root = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!root) return;

      var mainImg = root.querySelector('.oladerm__main-img');
      var thumbs = root.querySelectorAll('.oladerm__thumb');

      if (!mainImg || !thumbs.length) return;

      thumbs.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var src = btn.getAttribute('data-target-src');
          if (!src) return;

          thumbs.forEach(function(b){ b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          mainImg.setAttribute('src', src);
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Oladerm - Product Hero",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Fit into container",
      "default": "contained",
      "options": [
        { "value": "contained", "label": "Contained (page width)" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (optional)",
      "info": "Leave blank to use the current product when on a product page."
    },
    {
      "type": "select",
      "id": "default_media_position",
      "label": "Default image",
      "default": "featured",
      "options": [
        { "value": "featured", "label": "Featured media" },
        { "value": "first", "label": "First media" }
      ]
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top badge text (optional)",
      "default": "badge_text",
      "info": "If empty, will try product metafield custom.hero_badge_text"
    },
    {
      "type": "text",
      "id": "pill_1",
      "label": "Image pill 1 (optional)",
      "default": "pill 1",
      "info": "If empty, will try product metafield custom.hero_pill_1"
    },
    {
      "type": "text",
      "id": "pill_2",
      "label": "Image pill 2 (optional)",
      "default": "pill 1",
      "info": "If empty, will try product metafield custom.hero_pill_2"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Taxes included"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "View Products"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon image (circle)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Gentle on skin" },
        { "type": "text", "id": "text", "label": "Text", "default": "Cleans without irritation or stripping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oladerm - Product Hero",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
