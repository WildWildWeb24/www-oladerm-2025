{% comment %}
  Oladerm — Single Product + Banner (2-col)
  Left: product card pulled from selected product
  Right: banner (image + overlay text)
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% liquid
  assign s = section.settings
  assign product = s.product
  assign container_class = s.fit_container | default: true

  if s.fit_container
    assign wrap_class = 'page-width'
  else
    assign wrap_class = 'oladerm-spb__full'
  endif
%}

<section id="oladerm-spb-{{ section.id }}" class="oladerm-spb">
  <div class="{{ wrap_class }}">
    {% if s.show_collection_header %}
      <header class="oladerm-spb__header">
        {% if s.concern_title != blank %}
          <h1 class="oladerm-spb__title">{{ s.concern_title }}</h1>
        {% endif %}
        {% if s.concern_text != blank %}
          <div class="oladerm-spb__intro rte">{{ s.concern_text }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="oladerm-spb__grid">
      <!-- LEFT: SINGLE PRODUCT -->
      <div class="oladerm-spb__left">
        {% if product != blank %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          <div class="oladerm-spb__card">
            <a class="oladerm-spb__media" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900, 1080, 1200',
                  sizes: '(min-width: 990px) 520px, 100vw',
                  alt: product.title
                }}
              {% else %}
                <div class="oladerm-spb__mediaPlaceholder"></div>
              {% endif %}
            </a>

            <div class="oladerm-spb__content">
              <div class="oladerm-spb__top">
                <h2 class="oladerm-spb__productTitle">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h2>

                {% if s.product_tagline != blank %}
                  <p class="oladerm-spb__tagline">{{ s.product_tagline }}</p>
                {% endif %}

                <div class="oladerm-spb__price">
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="oladerm-spb__price--compare">
                      {{ current_variant.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="oladerm-spb__price--current">
                    {{ current_variant.price | money }}
                  </span>
                </div>

                {% if s.benefit_1 != blank or s.benefit_2 != blank or s.benefit_3 != blank %}
                  <ul class="oladerm-spb__bullets">
                    {% if s.benefit_1 != blank %}<li>{{ s.benefit_1 }}</li>{% endif %}
                    {% if s.benefit_2 != blank %}<li>{{ s.benefit_2 }}</li>{% endif %}
                    {% if s.benefit_3 != blank %}<li>{{ s.benefit_3 }}</li>{% endif %}
                  </ul>
                {% endif %}
              </div>

              <div class="oladerm-spb__actions">
                {% form 'product', product, class: 'oladerm-spb__form' %}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <input type="hidden" name="quantity" value="1">

                  <button
                    type="submit"
                    name="add"
                    class="oladerm-spb__atc"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    {% if current_variant.available %}
                      {{ s.atc_label | default: 'Add to cart' }}
                    {% else %}
                      Sold out
                    {% endif %}
                  </button>
                {% endform %}

                {% if s.show_view_product %}
                  <a class="oladerm-spb__link" href="{{ product.url }}">
                    {{ s.view_label | default: 'View product' }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>

        {% else %}
          <div class="oladerm-spb__empty">
            Select a product in this section’s settings.
          </div>
        {% endif %}
      </div>

      <!-- RIGHT: BANNER -->
      <div class="oladerm-spb__right">
        <div class="oladerm-spb__banner" style="--overlay: {{ s.banner_overlay | default: 0.25 }};">
          {% if s.banner_image != blank %}
            {{ s.banner_image | image_url: width: 2000 | image_tag:
              loading: 'lazy',
              widths: '750, 1100, 1500, 2000',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: s.banner_heading
            }}
          {% else %}
            <div class="oladerm-spb__bannerFallback"></div>
          {% endif %}

          {% if s.banner_heading != blank or s.banner_text != blank or s.banner_button_label != blank %}
            <div class="oladerm-spb__bannerOverlay">
              {% if s.banner_heading != blank %}
                <h3 class="oladerm-spb__bannerHeading">{{ s.banner_heading }}</h3>
              {% endif %}
              {% if s.banner_text != blank %}
                <p class="oladerm-spb__bannerText">{{ s.banner_text }}</p>
              {% endif %}
              {% if s.banner_button_label != blank and s.banner_button_link != blank %}
                <a class="oladerm-spb__bannerBtn" href="{{ s.banner_button_link }}">
                  {{ s.banner_button_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  #oladerm-spb-{{ section.id }} {
    --radius: 14px;
    --border: rgba(0,0,0,.08);
    --text: rgba(0,0,0,.86);
    --muted: rgba(0,0,0,.62);
    --bg: {{ section.settings.card_bg }};
    --btn: {{ section.settings.button_bg }};
    --btnText: {{ section.settings.button_text }};
    --gap: 28px;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__full { width: 100%; padding-left: 24px; padding-right: 24px; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__header { padding: 28px 0 18px; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__title { margin: 0 0 10px; color: var(--text); }
  #oladerm-spb-{{ section.id }} .oladerm-spb__intro { color: var(--muted); max-width: 900px; }

  #oladerm-spb-{{ section.id }} .oladerm-spb__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    align-items: start;
    padding: 18px 0 40px;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__media { display:block; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__media img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  #oladerm-spb-{{ section.id }} .oladerm-spb__mediaPlaceholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: rgba(0,0,0,.04);
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__content { padding: 18px 18px 16px; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__productTitle { margin: 0 0 6px; font-size: 28px; line-height: 1.15; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__productTitle a { color: var(--text); text-decoration: none; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__tagline { margin: 0 0 12px; color: var(--muted); }

  #oladerm-spb-{{ section.id }} .oladerm-spb__price { display:flex; gap: 10px; align-items: baseline; margin: 0 0 14px; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__price--compare { color: rgba(0,0,0,.45); text-decoration: line-through; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__price--current { color: var(--text); font-weight: 600; }

  #oladerm-spb-{{ section.id }} .oladerm-spb__bullets {
    margin: 0;
    padding: 0 0 0 18px;
    color: var(--muted);
    display: grid;
    gap: 8px;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__actions {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__atc {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 12px 18px;
    min-width: 200px;
    background: var(--btn);
    color: var(--btnText);
    cursor: pointer;
    font-weight: 600;
  }
  #oladerm-spb-{{ section.id }} .oladerm-spb__atc[disabled] { opacity: .6; cursor: not-allowed; }

  #oladerm-spb-{{ section.id }} .oladerm-spb__link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: .85;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__banner {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(0,0,0,.03);
    min-height: 100%;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__banner img {
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    display: block;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__bannerFallback {
    min-height: 520px;
    background: linear-gradient(135deg, rgba(0,0,0,.04), rgba(0,0,0,.02));
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__bannerOverlay {
    position: absolute;
    inset: 0;
    padding: 22px;
    display: grid;
    align-content: end;
    gap: 8px;
    background: linear-gradient(to top, rgba(0,0,0,var(--overlay)), rgba(0,0,0,0));
    color: #fff;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__bannerHeading { margin: 0; font-size: 24px; line-height: 1.15; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__bannerText { margin: 0; opacity: .92; max-width: 42ch; }
  #oladerm-spb-{{ section.id }} .oladerm-spb__bannerBtn {
    display: inline-flex;
    width: fit-content;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    color: #111;
    text-decoration: none;
    font-weight: 600;
    margin-top: 8px;
  }

  #oladerm-spb-{{ section.id }} .oladerm-spb__empty {
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 16px;
    color: var(--muted);
    background: rgba(0,0,0,.02);
  }

  /* Mobile */
  @media (max-width: 989px) {
    #oladerm-spb-{{ section.id }} .oladerm-spb__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    #oladerm-spb-{{ section.id }} .oladerm-spb__banner img,
    #oladerm-spb-{{ section.id }} .oladerm-spb__bannerFallback {
      min-height: 320px;
    }
    #oladerm-spb-{{ section.id }} .oladerm-spb__productTitle { font-size: 22px; }
    #oladerm-spb-{{ section.id }} .oladerm-spb__atc { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Oladerm — Single product",
  "settings": [
    {
      "type": "checkbox",
      "id": "fit_container",
      "label": "Fit into container (page width)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_header",
      "label": "Show top header (concern title + intro)",
      "default": true
    },
    {
      "type": "text",
      "id": "concern_title",
      "label": "Concern title",
      "default": "Dry & Dehydrated Skin"
    },
    {
      "type": "richtext",
      "id": "concern_text",
      "label": "Concern intro text",
      "default": "<p>Short 1–2 line intro explaining the concern. Keep it calm and simple.</p>"
    },

    { "type": "header", "content": "Left: Product" },
    {
      "type": "product",
      "id": "product",
      "label": "Choose product"
    },
    {
      "type": "text",
      "id": "product_tagline",
      "label": "Short benefit line",
      "default": "Restores moisture and prevents dryness"
    },
    { "type": "text", "id": "benefit_1", "label": "Key benefit 1", "default": "Deep hydration & nourishment" },
    { "type": "text", "id": "benefit_2", "label": "Key benefit 2", "default": "Strengthens the skin barrier" },
    { "type": "text", "id": "benefit_3", "label": "Key benefit 3", "default": "Prevents dryness or tightness" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "ADD TO CART" },
    { "type": "checkbox", "id": "show_view_product", "label": "Show “View product” link", "default": false },
    { "type": "text", "id": "view_label", "label": "View product label", "default": "View product" },

    { "type": "header", "content": "Right: Banner" },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "range",
      "id": "banner_overlay",
      "label": "Banner overlay strength",
      "min": 0,
      "max": 0.7,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading",
      "default": "Barrier care, made simple"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner text",
      "default": "Lightweight hydration that feels comfortable all day."
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Banner button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Banner button link"
    },

    { "type": "header", "content": "Style" },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Oladerm — Single product"
    }
  ]
}
{% endschema %}
