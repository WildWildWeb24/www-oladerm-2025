{
  "sections": {
    "hero_grid": {
      "type": "home-hero-grid",
      "blocks": {
        "tile_1": {
          "type": "tile",
          "settings": {
            "subheading": "Featured line",
            "heading": "Sunscreen",
            "body": "Protects your skin daily",
            "background_color": "#f5c174"
          }
        },
        "tile_2": {
          "type": "tile",
          "settings": {
            "subheading": "Velvet Skin",
            "heading": "Balm",
            "body": "Breathable balm that heals",
            "background_color": "#d87e8f"
          }
        },
        "tile_3": {
          "type": "tile",
          "settings": {
            "subheading": "SatinSkin",
            "heading": "Cleanser",
            "body": "Gentle cleanser that respects your skin",
            "background_color": "#6b8bcf"
          }
        },
        "tile_4": {
          "type": "tile",
          "settings": {
            "subheading": "Glowrevive",
            "heading": "Cream",
            "body": "Radiance-supporting cream for everyday",
            "background_color": "#5b4c5f"
          }
